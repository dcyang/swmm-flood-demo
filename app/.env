# Base URL of the SWMM Flask backend, called from the BROWSER.
# Must be an address the browser can reach (not 127.0.0.1 when accessed remotely).
VITE_API_BASE=http://127.0.0.1:5057

# --- Expose the dev server on a public domain (optional) -------------------
# Uncomment + set your real domain, then open the firewall for 5173 and 5057.
# Reach the app at http://your-domain:5173/
#VITE_DEV_HOST=0.0.0.0
#VITE_ALLOWED_HOSTS=mydomain.com,localhost
#VITE_API_BASE=http://mydomain.com:5057

# For an Android emulator hitting a host machine, use http://10.0.2.2:5057
